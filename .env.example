NODE_ENV=development
PORT=3000

# --- Local Postgres (default) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=hebir
DB_PASSWORD=hebir
DB_NAME=hebir

# --- OR managed Postgres (Neon / Supabase) ---
# App: use Neon *pooled* URL (hostname contains -pooler).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Migrations / DDL: Neon *direct* URL (no -pooler). See src/database/POOLING.md
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Local via docker-compose PgBouncer (port 6432) ---
# DATABASE_URL=postgresql://hebir:hebir@127.0.0.1:6432/hebir
# DATABASE_DIRECT_URL=postgresql://hebir:hebir@127.0.0.1:5432/hebir
# DB_USE_PGBOUNCER=true

# Client pool caps (TypeORM → node-pg). Behind pooler default max=10; else 20.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_APPLICATION_NAME=api-core

# --- Local Redis (default) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=16380

# --- OR managed Redis (Upstash) ---
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Location service (Go)
LOCATION_SVC_URL=http://localhost:8090

# Payment providers (subscription fee only)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
SUBSCRIPTION_FEE_ETB=1000
SUBSCRIPTION_CYCLE_DAYS=30
SUBSCRIPTION_GRACE_HOURS=24
# Paid-plan gate. Leave false until Chapa/Telebirr collections are live —
# drivers can go online, post routes, and receive offers without paying.
REQUIRE_DRIVER_SUBSCRIPTION=false

# Fare rates live in Neon `configuration` table (source of truth).
# Adjust independently without redeploying:
#   fare_initial_fee_etb   — flat starting fee
#   fare_per_meter_etb     — distance fee per meter (e.g. 0.016 = 16 ETB/km)
#   fare_per_minute_etb    — time fee
#   fare_minimum_etb       — floor before surge
# Or PATCH /fare/rates as admin. GET /fare/rates for apps.

# --- KYC document storage ---
# Default: local disk under ../.local-data/kyc-uploads (presign → PUT api-core).
# For real S3 / MinIO set all of:
# KYC_STORAGE_MODE=s3
# S3_BUCKET=hebir-kyc
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # optional (MinIO)
# PUBLIC_API_BASE_URL=http://127.0.0.1:3000  # local view links for Ops
KYC_STORAGE_MODE=local
PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# --- Schema / migrations ---
# Production: synchronize is always OFF. Use migrations.
# Local bootstrap only (never in production):
# TYPEORM_SYNCHRONIZE=true
TYPEORM_SYNCHRONIZE=false
# Run pending migrations on Nest boot (set false to manage manually):
TYPEORM_MIGRATIONS_RUN=true

# --- Rate limits (Redis; set RATE_LIMIT_ENABLED=false for heavy local seeds) ---
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_AUTH_REFRESH=30
# RATE_LIMIT_WEBHOOK=120
# RATE_LIMIT_GPS=20
# RATE_LIMIT_DEMAND=30

# --- Secrets (production) ---
# Local: leave unset or SECRETS_BACKEND=env (uses this .env).
# Production: SECRETS_BACKEND=aws + SECRETS_ARN (JSON secret). See docs/SECRETS.md
# SECRETS_BACKEND=env
# SECRETS_ARN=arn:aws:secretsmanager:eu-central-1:ACCOUNT:secret:hebir/api-core/prod
# AWS_REGION=eu-central-1
# SECRETS_BACKEND=file
# SECRETS_FILE=./secrets.json
# ALLOW_ENV_SECRETS_IN_PROD=false

# --- CORS + security headers ---
# Comma-separated browser Origins (Ops :5174, Gov :5173). Prod: set real HTTPS hosts.
# Flutter apps do not send Origin and are unaffected.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- Observability ---
LOG_LEVEL=info
# METRICS_DEFAULTS=true
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=api-core

